# Configuration de la stack pour un déploiement (Raspberry Pi).
# Copiez vers deploy.env, ajustez, puis :
#   docker compose --env-file deploy.env up -d --build

# --- Base de données ---
POSTGRES_USER=foxbaby
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=foxbaby

# --- Backend ---
# Secret de signature des JWT : valeur longue et aléatoire (ex: openssl rand -hex 32).
JWT_SECRET=change-me-please-long-random
# ID client OAuth Google (voir étape 7). Vide = bouton Google désactivé.
GOOGLE_CLIENT_ID=

# --- Réseau / HTTPS ---
# Domaine servi par Caddy : HTTPS automatique (Let's Encrypt) si c'est un vrai domaine.
SITE_ADDRESS=foxbaby.example.com
# Ports hôte -> Caddy. En prod : 80 et 443.
HTTP_PORT=80
HTTPS_PORT=443
# Cookies de session en HTTPS : true en prod.
COOKIE_SECURE=true

# --- Build du front ---
# Même origine que le front (servi par Caddy) : /api convient dans la quasi-totalité des cas.
VITE_API_BASE_URL=/api
# Doit correspondre à GOOGLE_CLIENT_ID pour activer le bouton Google.
VITE_GOOGLE_CLIENT_ID=
