# Configuration de la stack pour le déploiement (Raspberry Pi, derrière Nginx).
# Copiez vers deploy.env, ajustez, puis :
#   docker compose --env-file deploy.env up -d --build

# --- Base de données ---
POSTGRES_USER=foxbaby
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=foxbaby

# --- Backend ---
# Secret de signature des JWT : valeur longue et aléatoire (ex: openssl rand -hex 32).
JWT_SECRET=change-me-please-long-random
# ID client OAuth Google (voir sous-étape OAuth). Vide = bouton Google désactivé.
GOOGLE_CLIENT_ID=
# Cookies de session : true car le public passe en HTTPS (via Nginx).
COOKIE_SECURE=true
# Origine autorisée (même domaine que le front) — utile seulement si un jour
# front et API sont sur des origines différentes ; ici même origine.
CORS_ORIGIN=https://foxbaby.example.com

# --- Caddy (conteneur, derrière Nginx) ---
# Caddy écoute en HTTP interne ; c'est Nginx qui fait le HTTPS. Laissez ":80".
SITE_ADDRESS=:80

# --- Ports publiés sur l'hôte (tous bindés sur 127.0.0.1 uniquement) ---
# Front (Caddy) : port sur lequel Nginx proxifie. Doit correspondre au vhost Nginx.
FOXBABY_HTTP_PORT=
# API (backend) : accès direct/debug (l'app passe par /api via Caddy).
FOXBABY_API_PORT=
# Postgres : utile pour lancer la migration depuis l'hôte (DATABASE_URL sur ce port).
FOXBABY_DB_PORT=

# --- Intégration Nginx Proxy Manager (NPM) ---
# Nom du réseau Docker de NPM (voir `docker network ls`), pour que NPM puisse
# joindre le conteneur Caddy par l'alias "foxbaby:80". Utilisé avec
# -f docker-compose.npm.yml (voir ce fichier).
NPM_NETWORK=

# --- Build du front ---
# Même origine que le front (servi par Caddy derrière Nginx) : /api convient.
VITE_API_BASE_URL=/api
# Doit correspondre à GOOGLE_CLIENT_ID pour activer le bouton Google.
VITE_GOOGLE_CLIENT_ID=
