# Copiez ce fichier vers server/.env
DATABASE_URL=postgres://foxbaby:foxbaby@localhost:5432/foxbaby
PORT=3000

# Secret de signature des JWT (changez-le en production, valeur longue et aléatoire)
JWT_SECRET=dev-secret-change-me

# ID client OAuth Google (Console Google Cloud). Laissez vide tant que non configuré :
# les endpoints email/mdp fonctionnent sans, seul /api/auth/google le requiert.
GOOGLE_CLIENT_ID=

# Cookie de session : Secure=true seulement en HTTPS (donc false en dev http).
COOKIE_SECURE=false

# Origine autorisée pour le front (CORS + cookies). Front Vite en dev :
CORS_ORIGIN=http://localhost:5173
