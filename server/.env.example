# Copiez ce fichier vers server/.env
DATABASE_URL=postgres://foxbaby:foxbaby@localhost:5432/foxbaby
PORT=3000

# Secret de signature des JWT (changez-le en production, valeur longue et aléatoire)
JWT_SECRET=dev-secret-change-me

# ID client OAuth Google (Console Google Cloud). Laissez vide tant que non configuré :
# les endpoints email/mdp fonctionnent sans, seul /api/auth/google le requiert.
GOOGLE_CLIENT_ID=

# Cookie de session : Secure=true seulement en HTTPS (donc false en dev http).
COOKIE_SECURE=false

# Origine autorisée pour le front (CORS + cookies). Front Vite en dev :
CORS_ORIGIN=http://localhost:5173

# URL publique du front, utilisée pour construire le lien de réinitialisation
# envoyé par email. Par défaut : CORS_ORIGIN.
APP_URL=http://localhost:5173

# Durée de validité d'un lien de réinitialisation, en minutes.
PASSWORD_RESET_TTL_MINUTES=60

# SMTP (emails de réinitialisation de mot de passe).
# Tant que SMTP_HOST est vide, aucun email n'est envoyé : le lien est écrit
# dans les logs du serveur, ce qui suffit pour développer.
# Exemple Gmail : SMTP_PASS est un « mot de passe d’application » (16 caractères,
# https://myaccount.google.com/apppasswords), jamais le mot de passe du compte.
# SMTP_FROM doit porter la même adresse que SMTP_USER (Gmail impose l’expéditeur).
SMTP_HOST=
SMTP_PORT=465
# true = TLS implicite (port 465) ; false = STARTTLS (port 587).
SMTP_SECURE=true
SMTP_USER=votre.adresse@gmail.com
SMTP_PASS=
SMTP_FROM=FoxBaby <votre.adresse@gmail.com>
