# Copiez vers migration/.env

# Postgres cible (stack locale) :
DATABASE_URL=postgres://foxbaby:foxbaby@localhost:5432/foxbaby

# Chemin vers la clé de compte de service Firebase (JSON téléchargé depuis la
# console : Paramètres du projet > Comptes de service > Générer une nouvelle clé).
FIREBASE_SERVICE_ACCOUNT=./service-account.json

# Mot de passe par défaut attribué aux comptes email migrés (les comptes Google
# n'en reçoivent pas). Définissez une vraie valeur dans migration/.env (ignoré),
# et communiquez-la aux utilisateurs, qui la changeront dans l'app.
DEFAULT_PASSWORD=change-me
